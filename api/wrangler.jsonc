{
  // zkasper public API. Deploy from this directory:
  //   set -a; . ../../.cloudflare-zkasper; set +a
  //   npx --yes wrangler@4 deploy
  // Ingest token (server-side secret, read as env.INGEST_TOKEN):
  //   printf %s "$TOKEN" | npx --yes wrangler@4 secret put INGEST_TOKEN
  //
  // Proof bytes go to R2 via the PROOFS binding. Blobs written before R2 was
  // enabled stay inline in the Durable Object's SQLite and remain readable; the
  // storage abstraction in src/index.ts reads either.
  "name": "zkasper-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "durable_objects": {
    "bindings": [{ "name": "INDEX", "class_name": "IndexDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IndexDO"] }],
  "r2_buckets": [{ "binding": "PROOFS", "bucket_name": "zkasper-proofs" }],
  //
  // api.zkasper.com is attached as a Worker custom domain, but NOT from here:
  // this API token cannot read /zones/{zone}/workers/routes, so a "routes"
  // entry makes every `wrangler deploy` exit non-zero after a successful
  // upload. The domain was bound once, out of band, and survives redeploys:
  //   curl -X PUT "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/domains" \
  //     -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "content-type: application/json" \
  //     --data '{"zone_id":"<zkasper.com zone>","hostname":"api.zkasper.com","service":"zkasper-api","environment":"production"}'
  "workers_dev": true,
  "observability": { "enabled": true }
}
